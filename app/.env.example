# Deployed Apps Script Web App URL (ends with /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
# Shared-secret token that must match the backend's Script Property API_TOKEN
VITE_APPS_SCRIPT_TOKEN=REPLACE_ME
# true = use in-memory mock data, false = call the Apps Script backend above
VITE_USE_MOCK=true
